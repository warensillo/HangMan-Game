<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.hangman.Controllers.DifficultySelectionController"
            prefHeight="400.0" prefWidth="600.0">

    <Label text="Select Difficulty" style="-fx-font-size: 24px;"/>
    <Button text="Easy" onAction="#onDifficultySelected"/>
    <Button text="Medium" onAction="#onDifficultySelected"/>
    <Button text="Difficult" onAction="#onDifficultySelected"/>

</AnchorPane>
