<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.hangman.Controllers.MainMenuController"
            prefHeight="400.0" prefWidth="600.0">

    <Label text="Welcome to Hangman!" style="-fx-font-size: 24px;"/>
    <Button text="Start Game" onAction="#onStartGameButtonClick"/>
    <Button text="Exit" onAction="#onExitButtonClick"/>

</AnchorPane>

